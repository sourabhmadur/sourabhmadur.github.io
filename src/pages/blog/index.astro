---
import Layout from "../../layouts/Layout.astro";
import { getPosts } from "../../lib/supabase";
import { blogPageContent } from "../../config";

const posts = await getPosts();

function readingTime(text: string) {
  const words = text.trim().split(/\s+/).length;
  const minutes = Math.max(1, Math.round(words / 200));
  return `${minutes} min read`;
}
---

<Layout seo={blogPageContent.seo}>
  <section class="mt-10 max-w-2xl mx-auto px-6 scroll-reveal">
    <h1 class="font-bold text-3xl mb-14">Blog</h1>

    <div class="grid grid-cols-1 gap-8 mb-10">
      {
        posts.map((post) => (
          <a href={`/blog/${post.slug}`} class="post">
            <p class="opacity-60 mb-2">
              {new Date(post.pub_date).toLocaleDateString()} &middot; {readingTime(post.content)}
            </p>
            <h3 class="font-medium hover-underline">{post.title}</h3>
            <p class="text-sm opacity-60 mt-2 mb-3">{post.description}</p>
          </a>
        ))
      }
    </div>
  </section>
</Layout>
