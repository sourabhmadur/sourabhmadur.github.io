---
import Layout from "../layouts/Layout.astro";
import { aboutPageContent } from "../config";
---

<Layout seo={aboutPageContent.seo}>
  <section class="mt-10 max-w-2xl mx-auto px-6 scroll-reveal">
    <h1 class="font-bold text-3xl mb-8">About</h1>
    <div class="prose text-base leading-relaxed space-y-4">
      {aboutPageContent.description.map((paragraph) => (
        <p set:html={paragraph} />
      ))}
    </div>
  </section>
</Layout>
