source 'https://rubygems.org'

gem 'jekyll', '~> 4.3'
gem 'rouge'
gem 'webrick'
# Pin to the Ruby-Sass (sassc) converter: the Tufte SCSS uses relative
# `@import "../_sass/..."` paths that the dart-sass converter (3.x) trips on.
gem 'jekyll-sass-converter', '~> 2.2'

# Custom Tufte Liquid tags live in _plugins/, so this site must be built
# with full Jekyll (not GitHub Pages' safe mode). Build/deploy via GitHub
# Actions — see .github/workflows/jekyll.yml.
